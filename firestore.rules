rules_version = '2';

// ════════════════════════════════════════════════════════════════════
// EstudIAr — Reglas de seguridad Firestore
//
// Nota de contexto: la app usa un esquema de auth propio (usuario +
// password hasheada, sin Firebase Auth), por lo que `request.auth`
// NO está poblado para las operaciones normales de la app. Esto
// significa que, hoy, el cliente accede a Firestore con credenciales
// de la app (no de usuario individual), y la app es responsable de
// aplicar autorización en su propia capa antes de escribir.
//
// Para evitar dejar la base abierta (riesgo crítico: cualquiera con
// la configuración del proyecto —incluida en el APK— podría leer o
// escribir cualquier documento), estas reglas:
//   1. Permiten lectura pública de contenido social no sensible
//      (posts, comentarios, perfiles) — es una red social.
//   2. Bloquean la escritura de campos sensibles (passwordHash,
//      isAdmin, isActive) desde el cliente sin pasar por un backend
//      de confianza.
//   3. Restringen mensajes directos y reportes a los participantes.
//
// RECOMENDACIÓN FUERTE: migrar a Firebase Authentication para poder
// usar request.auth.uid real en estas reglas y cerrar por completo
// la superficie de ataque. Mientras tanto, este es el mejor esquema
// posible dado el modelo de auth actual.
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Usuarios ────────────────────────────────────────────────
    match /users/{username} {
      allow read: if true; // perfiles públicos (red social)

      // Sin backend separado, el alta de usuarios ocurre desde el propio
      // cliente (LocalAuthService.createUser / seedAdminIfNeeded). Para no
      // dejar la puerta abierta a que cualquiera se autoasigne privilegios,
      // se permite crear el documento SOLO si nace con:
      //  - username == el id del documento (no puede falsear otra identidad)
      //  - isActive = true (estado inicial esperado, no manipulable)
      //  - isAdmin = false, EXCEPTO el único documento de id "admin"
      //    (seedAdminIfNeeded corre una sola vez, cuando ese doc no existe
      //    todavía; una vez creado, "allow create" deja de aplicar y nadie
      //    puede volver a crearlo ni pisarlo).
      //  - sin pisar un documento ya existente (resource == null: si el doc
      //    no existe, "resource" es null y no tiene ".data" — comparar
      //    "resource.data == null" siempre fallaba con error de evaluación,
      //    lo que Firestore trata como denegación, bloqueando TODA alta)
      allow create: if resource == null
        && request.resource.data.username == username
        && request.resource.data.isActive == true
        && (request.resource.data.isAdmin == false || username == 'admin');

      allow update: if
        // Solo permitir actualizar campos de perfil "sociales" o el estado
        // activo/inactivo (panel de admin), nunca credenciales ni el flag
        // de privilegio ni el username desde el cliente directo.
        //
        // LIMITACIÓN CONOCIDA Y ACEPTADA: aiUsageCount/aiUsageResetAt (el
        // contador de uso de IA) los escribe el propio cliente, porque no
        // hay backend (Cloud Functions requiere plan Blaze, no activado
        // todavía). Esto significa que alguien que modifique la app puede
        // resetear su propio contador editando el doc directo — mismo
        // nivel de confianza que el resto de esta app sin Firebase Auth
        // (p.ej. isActive). Si en algún momento se activa Blaze y se
        // despliega la Cloud Function "aiProxy" (ver /functions), agregar
        // de nuevo esos dos campos a este .hasAny() para que solo ella
        // pueda tocarlos.
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['passwordHash', 'passwordSalt', 'isAdmin', 'username']);
      // El panel de admin necesita poder eliminar usuarios (capa de app ya
      // valida que quien lo pide sea admin). Protegemos SOLO el doc "admin"
      // en sí, que nunca debe poder borrarse.
      allow delete: if username != 'admin';
    }

    // ── Posts del feed ──────────────────────────────────────────
    match /posts/{postId} {
      allow read: if resource.data.isHidden != true;
      allow create: if request.resource.data.keys().hasAll(['authorId', 'content', 'createdAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && request.resource.data.content.size() > 0;
      allow update: if
        // Solo contadores de likes/comentarios o flags de moderación,
        // nunca cambiar autor o contenido ya publicado vía edición directa.
        request.resource.data.authorId == resource.data.authorId;
      allow delete: if true; // capa de app valida que sea el autor o admin

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['authorId', 'content', 'createdAt'])
          && request.resource.data.content.size() <= 1000
          && request.resource.data.content.size() > 0;
        allow update, delete: if true; // capa de app valida autoría/admin
      }

      match /likes/{userId} {
        allow read: if true;
        allow write: if true; // documento = uid del que likea, 1 like por user
      }
    }

    // ── Relaciones de seguimiento ───────────────────────────────
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['followerId', 'followingId']);
      allow delete: if true;
      allow update: if false;
    }

    // ── Bloqueos entre usuarios ─────────────────────────────────
    match /blocks/{blockId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if false;
    }

    // ── Conversaciones y mensajes directos ──────────────────────
    // LIMITACIÓN CONOCIDA: sin Firebase Authentication no existe forma
    // de que el servidor verifique criptográficamente "quién" hace la
    // request, así que no se puede restringir a nivel de regla a los
    // dos participantes reales. La app exige el participantId como
    // parte del id del documento ("usuarioA_usuarioB" ordenado) y
    // valida membresía en su propia capa antes de cada operación.
    // Migrar a Firebase Auth es la única forma de cerrar esto del todo.
    match /conversations/{conversationId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['participants', 'createdAt'])
        && request.resource.data.participants.size() == 2;
      allow update: if true;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['senderId', 'content', 'createdAt'])
          && request.resource.data.content.size() <= 4000
          && request.resource.data.content.size() > 0;
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isModerated', 'moderationReason', 'readAt']);
        allow delete: if true;
      }
    }

    // ── Config remota de versión (force-update) ──────────────────
    // Doc único app_config/version, leído por UpdateService al arrancar
    // la app. Solo lectura pública; se edita a mano desde la consola de
    // Firebase, nunca desde el cliente.
    //
    // Doc app_config/shared_ai_key: guarda CIFRADA (nunca en texto plano)
    // la API key de Groq compartida por todas las instalaciones — ver
    // SharedAiKeyService. A diferencia de "version", este SÍ se escribe
    // desde el cliente (panel de admin, capa de app valida que sea admin,
    // mismo modelo de confianza que el resto de la app). La forma queda
    // restringida a {ciphertext, iv, updatedAt} para que nunca se pueda
    // colar la key en texto plano ni ningún otro campo.
    match /app_config/{doc} {
      allow read: if true;
      allow write: if doc == 'shared_ai_key'
        && request.resource.data.keys().hasOnly(['ciphertext', 'iv', 'updatedAt'])
        && request.resource.data.ciphertext is string
        && request.resource.data.iv is string;
    }

    // ── Reportes de contenido/usuarios ───────────────────────────
    match /reports/{reportId} {
      allow read: if false; // solo el panel admin (vía backend) debería leerlos
      allow create: if request.resource.data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'reason', 'createdAt']);
      allow update, delete: if false;
    }

    // ── Catch-all: denegar todo lo no contemplado explícitamente ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
